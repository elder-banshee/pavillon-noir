# Normalisation Git : tous les fichiers texte en LF dans le dépôt
* text=auto eol=lf

# Fichiers explicitement texte
*.js    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.svg   text eol=lf
*.ps1   text eol=lf

# Fichiers binaires — pas de conversion
*.jpg   binary
*.png   binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
